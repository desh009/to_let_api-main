PORT=3000
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=YOUR_SERVICE_ROLE_KEY

# Node Environment (development or production)
NODE_ENV=development

# Required only if you want Supabase's password-reset email to redirect to a specific app/web URL.
PASSWORD_RESET_REDIRECT_URL=

# ========================================
# EMAIL SERVICE (Choose ONE option)
# ========================================

# Option 1: Gmail SMTP (Recommended for testing)
# Get App Password: https://myaccount.google.com/apppasswords
SMTP_SERVICE=gmail
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-16-char-app-password

# Option 2: Generic SMTP (for other providers)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_EMAIL=noreply@yourdomain.com
# SMTP_PASSWORD=your-password

# ========================================
# SMS SERVICE (Twilio)
# ========================================
# Get credentials: https://console.twilio.com
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ========================================
# NOTES
# ========================================
# 
# Gmail Setup:
# 1. Enable 2-Factor Authentication
# 2. Create App Password: https://myaccount.google.com/apppasswords
# 3. Use that 16-character password in SMTP_PASSWORD
#
# Twilio Setup (Optional - for SMS OTP):
# 1. Sign up: https://www.twilio.com/try-twilio (FREE trial)
# 2. Get free phone number
# 3. Get Account SID and Auth Token
# 4. Add credentials above
#
# Development Mode:
# - Set NODE_ENV=development
# - OTPs will log to console
# - Email/SMS failures won't stop the flow
#
# Production Mode:
# - Set NODE_ENV=production
# - Real emails/SMS will be sent
# - Failures will return errors

